# Physical Android/iPhone connected to the same Wi-Fi as the PC:
# replace 192.168.1.100 with your computer's LAN IPv4 address.
EXPO_PUBLIC_API_URL=http://192.168.1.100:5000/api

# Android emulator:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:5000/api

# iOS simulator:
# EXPO_PUBLIC_API_URL=http://localhost:5000/api
